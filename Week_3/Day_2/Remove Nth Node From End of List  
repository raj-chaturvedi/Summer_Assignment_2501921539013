class Solution {

    public ListNode removeNthFromEnd(ListNode head, int n) {

        ListNode dummy = new ListNode(0);
        dummy.next = head;

        ListNode fast = dummy;
        ListNode slow = dummy;

        // Fast ko n steps aage bhejo
        for (int i = 0; i <= n; i++) {
            fast = fast.next;
        }

        // Dono ko saath chalao
        while (fast != null) {
            fast = fast.next;
            slow = slow.next;
        }

        // Delete node
        slow.next = slow.next.next;

        return dummy.next;
    }
}